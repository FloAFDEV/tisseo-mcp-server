{
  "name": "tisseo-mcp-server",
  "version": "1.0.0",
  "description": "Serveur MCP pour l'API Tisséo (transports en commun de Toulouse) : prochains passages, recherche d'arrêts, lignes, perturbations et calcul d'itinéraires.",
  "type": "module",
  "main": "src/stdio.js",
  "bin": {
    "tisseo-mcp-server": "src/stdio.js"
  },
  "scripts": {
    "start": "node src/stdio.js",
    "dev": "node src/stdio.js",
    "inspect": "npx @modelcontextprotocol/inspector node src/stdio.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tisseo",
    "toulouse",
    "transit",
    "transports",
    "poke"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  }
}
